      <aliases enabled='yes' />
      <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
      <column caption='Profit Margin %' datatype='real' default-format='p0.00%' name='[Calculation_0547028037283840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Discounted_Price_INR] - [Metal_Value_INR] - [Making_Charge_INR] - [GST_INR])&#10;/&#10;[Discounted_Price_INR]&#10;* 100' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_0547028038373377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discounted_Price_INR] &lt; 5000 THEN &quot;Budget&quot;&#10;&#10;ELSEIF [Discounted_Price_INR] &lt; 10000 THEN &quot;Mid-Range&quot;&#10;&#10;ELSE &quot;Premium&quot;&#10;&#10;END' />
      </column>
